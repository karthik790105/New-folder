# Go Fresh Backend — Environment Variables
# Copy this file to .env and fill in your values

# Fast2SMS API Key (get from https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# JWT Secret (change in production)
JWT_SECRET=gofresh-super-secret-jwt-2024

# MongoDB (optional - app works in mock mode without this)
MONGO_URI=mongodb://localhost:27017/gofresh

# Server Port
PORT=5000
